#: src/notifier.cpp:22
#, kde-format
msgid "Upgrade available"
msgstr "Доступна надоградња"

#: src/notifier.cpp:23
#, kde-format
msgctxt "For example, 'KDE neon 24.04 is available.'"
msgid "%1 %2 is available."
msgstr "Доступно: %1 %2."

#: src/notifier.cpp:25
#, kde-format
msgid ""
"\n"
"Your device will stop receiving updates and security fixes in 1 day — please "
"upgrade when possible."
msgid_plural ""
"\n"
"Your device will stop receiving updates and security fixes in %1 days — "
"please upgrade when possible."
msgstr[0] ""
"\n"
"Ваш уређај ће престати да прима допуне и безбједносне исправке за %1 дан — "
"надоградите га чим будете могли."
msgstr[1] ""
"\n"
"Ваш уређај ће престати да прима допуне и безбједносне исправке за %1 дана — "
"надоградите га чим будете могли."
msgstr[2] ""
"\n"
"Ваш уређај ће престати да прима допуне и безбједносне исправке за %1 дана — "
"надоградите га чим будете могли."
msgstr[3] ""
"\n"
"Ваш уређај ће престати да прима допуне и безбједносне исправке за један дан "
"— надоградите га чим будете могли."

#: src/notifier.cpp:30
#, kde-format
msgid ""
"\n"
"Your device is no longer receiving updates or security fixes — please "
"upgrade now."
msgstr ""
"\n"
"Ваш уређај више не прима допуне ни безбједносне исправке — надоградите га "
"сада."

#: src/notifier.cpp:49
#, kde-format
msgctxt "@action:button"
msgid "Upgrade"
msgstr "Надогради"

#: src/screensaverinhibitor.cpp:24
#, kde-format
msgctxt "Screensaver inhibition reason"
msgid "Upgrading Operating System"
msgstr "Надоградња оперативног система"

#: src/upgraderprocess.cpp:98
#, kde-format
msgctxt "@title/window upgrade failure dialog"
msgid "Upgrade Failed"
msgstr "Надоградња није успјела"

#: src/upgraderprocess.cpp:104
#, kde-format
msgctxt "@title title widget above process output"
msgid "Upgrade failed with the following output:"
msgstr "Надоградња није успјела, уз сљедећи излаз:"
