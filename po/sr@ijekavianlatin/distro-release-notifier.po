#: src/notifier.cpp:22
#, kde-format
msgid "Upgrade available"
msgstr "Dostupna nadogradnja"

#: src/notifier.cpp:23
#, kde-format
msgctxt "For example, 'KDE neon 24.04 is available.'"
msgid "%1 %2 is available."
msgstr "Dostupno: %1 %2."

#: src/notifier.cpp:25
#, kde-format
msgid ""
"\n"
"Your device will stop receiving updates and security fixes in 1 day — please "
"upgrade when possible."
msgid_plural ""
"\n"
"Your device will stop receiving updates and security fixes in %1 days — "
"please upgrade when possible."
msgstr[0] ""
"\n"
"Vaš uređaj će prestati da prima dopune i bezbjednosne ispravke za %1 dan — "
"nadogradite ga čim budete mogli."
msgstr[1] ""
"\n"
"Vaš uređaj će prestati da prima dopune i bezbjednosne ispravke za %1 dana — "
"nadogradite ga čim budete mogli."
msgstr[2] ""
"\n"
"Vaš uređaj će prestati da prima dopune i bezbjednosne ispravke za %1 dana — "
"nadogradite ga čim budete mogli."
msgstr[3] ""
"\n"
"Vaš uređaj će prestati da prima dopune i bezbjednosne ispravke za jedan dan "
"— nadogradite ga čim budete mogli."

#: src/notifier.cpp:30
#, kde-format
msgid ""
"\n"
"Your device is no longer receiving updates or security fixes — please "
"upgrade now."
msgstr ""
"\n"
"Vaš uređaj više ne prima dopune ni bezbjednosne ispravke — nadogradite ga "
"sada."

#: src/notifier.cpp:49
#, kde-format
msgctxt "@action:button"
msgid "Upgrade"
msgstr "Nadogradi"

#: src/screensaverinhibitor.cpp:24
#, kde-format
msgctxt "Screensaver inhibition reason"
msgid "Upgrading Operating System"
msgstr "Nadogradnja operativnog sistema"

#: src/upgraderprocess.cpp:98
#, kde-format
msgctxt "@title/window upgrade failure dialog"
msgid "Upgrade Failed"
msgstr "Nadogradnja nije uspjela"

#: src/upgraderprocess.cpp:104
#, kde-format
msgctxt "@title title widget above process output"
msgid "Upgrade failed with the following output:"
msgstr "Nadogradnja nije uspjela, uz sljedeći izlaz:"
